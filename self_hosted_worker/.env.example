# Le worker local se configure via le Studio HTTPS.
# Aucun mot de passe Postgres ou Redis ne doit etre stocke sur le PC.
STUDIO_URL=https://auto-director-web.onrender.com

# Le lancement normal depuis le Studio fournit un jeton worker temporaire.
# Si tu lances manuellement START_LOCAL_WORKER_WINDOWS.ps1, le script te demandera
# le mot de passe du Studio uniquement pour obtenir ce jeton HTTPS.
STUDIO_PASSWORD=

# Mode materiel automatique recommande.
AUTO_PROFILE=1
PORT=10001

# Reglages facultatifs, normalement inutiles.
# LOCAL_VLM_MODEL=qwen2.5vl:3b
# RENDER_WIDTH=720
# RENDER_HEIGHT=1280
# MAX_REVISIONS=1
# FFMPEG_THREADS=2

# IMPORTANT : DATABASE_URL et REDIS_URL ne sont pas requis et ne doivent pas etre
# configures pour le worker PC de production. Le PC communique uniquement avec
# l'API HTTPS Auto Director au moyen d'un jeton worker temporaire.
