# Le worker local se configure maintenant via le Studio HTTPS.
# Aucun mot de passe Postgres ou Redis n'a besoin d'etre stocke sur le PC.
STUDIO_URL=https://auto-director-web.onrender.com

# Laisse vide pour que le lanceur demande le mot de passe du Studio a chaque demarrage.
# Si tu veux un demarrage totalement automatique, tu peux definir STUDIO_PASSWORD ici,
# mais ce fichier .env est prive et ne doit jamais etre partage.
STUDIO_PASSWORD=

# Mode materiel automatique recommande.
AUTO_PROFILE=1
PORT=10001

# Les reglages ci-dessous sont facultatifs et normalement inutiles.
# LOCAL_VLM_MODEL=qwen2.5vl:3b
# RENDER_WIDTH=720
# RENDER_HEIGHT=1280
# MAX_REVISIONS=1
# FFMPEG_THREADS=2

# Fallback avance uniquement : si le bootstrap HTTPS n'est pas disponible,
# tu peux definir manuellement DATABASE_URL et REDIS_URL ici.
# DATABASE_URL=postgresql://...
# REDIS_URL=rediss://...
