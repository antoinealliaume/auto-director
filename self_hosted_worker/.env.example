# Connexions Render: copie les URL EXTERNES depuis le dashboard Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Aucun reglage materiel n'est obligatoire.
# START_LOCAL_WORKER_WINDOWS.ps1 detecte automatiquement RAM/CPU/GPU et applique un profil prudent.
# Le rendu reste en 720x1280 par defaut pour eviter de saturer le PC.

# Tu peux forcer un reglage plus tard si tu veux, mais ce n'est pas necessaire.
# LOCAL_VLM_MODEL=qwen2.5vl:3b
# RENDER_WIDTH=720
# RENDER_HEIGHT=1280
# MAX_REVISIONS=1
# FFMPEG_THREADS=3

PORT=10001
